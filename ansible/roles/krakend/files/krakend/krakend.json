{
  "version": 3,
  "name": "krakend",
  "port": 8080,
  "timeout": "3s",
  "cache_ttl": "300s",
  "extra_config": {
    "security/cors": {
      "allow_origins": ["*"],
      "allow_methods": ["GET", "POST", "OPTIONS"],
      "allow_headers": ["Content-Type", "Authorization"],
      "expose_headers": ["Content-Length"],
      "max_age": "12h"
    }
  },
  "endpoints": [
    {
      "endpoint": "/payments/initiate",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/functions/v1/payments/initiate",
          "host": [
            "http://payment-kong:8000"
          ]
        }
      ]
    },
    {
      "endpoint": "/payments/initiate",
      "method": "OPTIONS",
      "backend": [
        {
          "url_pattern": "/functions/v1/payments/initiate",
          "host": [
            "http://payment-kong:8000"
          ]
        }
      ]
    },
    {
      "endpoint": "/payments/initiate-payment",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/functions/v1/payments/initiate-payment",
          "host": [
            "http://payment-kong:8000"
          ]
        }
      ]
    },
    {
      "endpoint": "/payments/initiate-payment",
      "method": "OPTIONS",
      "backend": [
        {
          "url_pattern": "/functions/v1/payments/initiate-payment",
          "host": [
            "http://payment-kong:8000"
          ]
        }
      ]
    },
    {
      "endpoint": "/payments/redirect",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/functions/v1/payments/redirect",
          "host": [
            "http://payment-kong:8000"
          ]
        }
      ]
    },
    {
      "endpoint": "/payments/order/{order_id}",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/functions/v1/payments/order/{order_id}",
          "host": [
            "http://payment-kong:8000"
          ]
        }
      ]
    },
    {
      "endpoint": "/payments/transaction/{transaction_id}",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/functions/v1/payments/transaction/{transaction_id}",
          "host": [
            "http://payment-kong:8000"
          ]
        }
      ]
    },
    {
      "endpoint": "/payments/webhook/{payment_gateway}",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/functions/v1/payments/webhook/{payment_gateway}",
          "host": [
            "http://payment-kong:8000"
          ]
        }
      ]
    },
    {
      "endpoint": "/payments/webhook/{payment_gateway}",
      "method": "OPTIONS",
      "backend": [
        {
          "url_pattern": "/functions/v1/payments/webhook/{payment_gateway}",
          "host": [
            "http://payment-kong:8000"
          ]
        }
      ]
    }
  ]
}
