############
# Secrets
# YOU MUST CHANGE THESE BEFORE GOING INTO PRODUCTION
############

POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOi...
SERVICE_ROLE_KEY=eyJhbGciOi...
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated
SECRET_KEY_BASE=your-super-secret-pooler-and-realtime-key-base-at-least-64-characters-long
VAULT_ENC_KEY=your-super-secret-vault-encryption-key-32-bytes-long

############
# Database - You can change these to any PostgreSQL database that has logical replication enabled.
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# API Proxy - Configuration for the Kong Reverse proxy.
############

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############
# API - Configuration for PostgREST.
############

PGRST_DB_SCHEMAS=public,storage,graphql_public

############
# Auth - Configuration for the GoTrue authentication server.
############

## General
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
API_EXTERNAL_URL=http://localhost:8000

## Mailer
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

## Phone
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

## Anonymous users
ENABLE_ANONYMOUS_USERS=false

## Keycloak Integration
EXTERNAL_KEYCLOAK_ENABLED=false
EXTERNAL_KEYCLOAK_CLIENT_ID=
EXTERNAL_KEYCLOAK_SECRET=
EXTERNAL_KEYCLOAK_REDIRECT_URI=
EXTERNAL_KEYCLOAK_URL=

############
# Studio - Configuration for the Dashboard
############

STUDIO_DEFAULT_ORGANIZATION=kasih
STUDIO_DEFAULT_PROJECT=kasih
SUPABASE_PUBLIC_URL=http://localhost:8000

############
# Storage - Configuration for Supabase Storage & MinIO
############

MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
IMGPROXY_ENABLE_WEBP_DETECTION=true

############
# Functions - Configuration for Edge Runtime
############

FUNCTIONS_VERIFY_JWT=false

# Cross-module communication
EIMUNISASI_SUPABASE_URL=
EIMUNISASI_SUPABASE_SERVICE_ROLE_KEY=
EIMUNISASI_SUPABASE_ANON_KEY=

ENAKES_SUPABASE_URL=
ENAKES_SUPABASE_SERVICE_ROLE_KEY=
ENAKES_SUPABASE_ANON_KEY=

PAYMENT_SUPABASE_URL=
PAYMENT_SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_SUPABASE_ANON_KEY=

############
# Pooler - Configuration for Supavisor
############

POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_TENANT_ID=kasih
POOLER_DEFAULT_POOL_SIZE=10
POOLER_MAX_CLIENT_CONN=100

############
# Analytics & Logging
############

LOGFLARE_API_KEY=your-super-secret-logflare-key
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
GRAFANA_USER=
GRAFANA_TOKEN=
GRAFANA_HOST=
